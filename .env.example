# Copy to .env and adjust.  Every variable is optional; defaults are shown.

# --- Paths: directory and file names are configured separately ---------------
# SS_DATA_DIR=./data
# SS_DB_FILENAME=socialsentiment.db
# SS_LOG_FILENAME=socialsentiment.log

# --- Collection ---------------------------------------------------------------
# Comma separated.  Empty = keep everything the source delivers.
# SS_TRACK_TERMS=bitcoin,ethereum,nvidia
# Comma separated language tags.  Empty = all languages.
# SS_LANGS=en
# SS_RETENTION_DAYS=3
# SS_WRITE_FLUSH_SECONDS=1.0
# SS_TRENDING_INTERVAL_SECONDS=30
# SS_TRENDING_SAMPLE_SIZE=5000
# SS_TRENDING_TOP_N=12
# SS_PURGE_INTERVAL_SECONDS=3600
# SS_POSITIVE_THRESHOLD=0.1

# --- Bluesky (no credentials needed) ------------------------------------------
# SS_BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# --- Reddit: create a "script" app at https://www.reddit.com/prefs/apps -------
# SS_REDDIT_CLIENT_ID=
# SS_REDDIT_CLIENT_SECRET=
# SS_REDDIT_USER_AGENT=socialsentiment/2.0 (by u/your_username)
# SS_REDDIT_SUBREDDITS=CryptoCurrency,Bitcoin,ethereum,stocks,wallstreetbets,investing

# --- RSS ---------------------------------------------------------------------
# SS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
# SS_RSS_POLL_SECONDS=300
# SS_RSS_USER_AGENT=socialsentiment/2.0

# --- X / Twitter API v2 (filtered stream needs a paid tier) -------------------
# SS_X_BEARER_TOKEN=

# --- Synthetic demo source -----------------------------------------------------
# SS_SYNTHETIC_RATE_PER_SECOND=5

# --- Dashboard ----------------------------------------------------------------
# SS_DASH_HOST=127.0.0.1
# SS_DASH_PORT=8050
# SS_DASH_DEBUG=false
# SS_DEFAULT_TERM=bitcoin
# SS_LIVE_WINDOW_POSTS=1000
# SS_HISTORY_WINDOW_POSTS=10000
# SS_RECENT_TABLE_ROWS=12
# SS_LIVE_REFRESH_MS=2000
# SS_HISTORY_REFRESH_MS=30000
